[Unit]
Description=PDA Facebook Page poster (schedules approved Premier Dental Academy posts)
Documentation=https://github.com/RealRyanNichols/PremierDentalAcademyofLongview/tree/ops/fb-poster/ops/fb-poster
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pdafb
Group=pdafb
ExecStart=/usr/bin/python3 /opt/pda-fb-poster/pda_fb_poster.py run
TimeoutStartSec=600
Nice=10
MemoryMax=256M
CPUQuota=25%
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/pda-fb-poster
