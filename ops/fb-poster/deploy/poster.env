# pda-fb-poster settings (KEY=value). Each run re-reads this file; no restart needed.
PDAFB_PAGE_ID=180743142587539
PDAFB_PAGE_NAME=Premier Dental Academy of Longview
PDAFB_GRAPH=https://graph.facebook.com/v23.0
# Schedule each post this many days before its time (Facebook's API allows up to 30).
PDAFB_WINDOW_DAYS=29.5
# Never schedule a post less than this many minutes before its time.
PDAFB_MIN_LEAD_MIN=20
# Posts at or before this time were loaded by hand in Business Suite before the droplet took over.
# The installer fills this in; it stops mattering once those dates have passed.
PDAFB_START_AFTER=
# Space-separated https links to extra approved queue files (for example the monthly queue on Drive).
PDAFB_REMOTE_QUEUES=
# 1 = when an image for a post arrives after the post was scheduled as text, swap in the photo version.
PDAFB_UPGRADE_IMAGES=1
